# 复制为 backend/.env 后填写本地随机密码；此文件兼容 Compose 和 Spring properties。
# 密码建议使用随机十六进制字符，避免两类解析器的特殊字符差异。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_USER=printer_app
MYSQL_DATABASE=printer_after_sales
APP_PORT=8080
# 本机 HTTP 为 false；HTTPS 部署设 true。
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m
QDRANT_URL=http://127.0.0.1:16333
AI_ENABLED=false
# AI_ENABLED=true时启用T026；按请求延迟创建客户端，默认关闭，无配置不调用模型。
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=
AI_API_KEY=
# T028：仅填已明确获准发给聊天模型的正文SHA-256，逗号分隔；embedding许可不等于聊天许可。
# 默认空：命中资料也不向聊天模型发送正文。验证用授权仅在验证进程内注入，不写入本地.env。
KNOWLEDGE_CHAT_ALLOWED_HASHES=
# T029：模型次数按实际尝试计（含只读重试），工具次数按宿主调用计；每个只读HTTP最多重试一次。
ASSISTANT_MAX_MODEL_CALLS=4
ASSISTANT_MAX_TOOL_CALLS=6
ASSISTANT_REQUEST_TIMEOUT_MS=20000
ASSISTANT_TURN_TIMEOUT_MS=60000
ASSISTANT_READ_RETRIES=1
# T030：AUTO只记录端点类别，不据此声称真实模型已验证；本机协议夹具可显式PROTOCOL_SIMULATION。
ASSISTANT_MODEL_MODE=AUTO
# 仅 --seed-demo 显式导入时，缺失账号才需要；无内置默认密码。
SEED_CUSTOMER_A_PASSWORD=
SEED_CUSTOMER_B_PASSWORD=
SEED_STAFF_PASSWORD=
